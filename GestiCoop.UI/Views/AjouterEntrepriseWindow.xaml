<Window x:Class="GestiCoop.UI.Views.AjouterEntrepriseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une entreprise — GestiCoop"
        Width="500" Height="520"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Champ" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête bleu -->
        <Border Grid.Row="0" Background="#1F4E79" Padding="20,14">
            <TextBlock Text="Ajouter une entreprise" Foreground="White"
                       FontSize="17" FontWeight="SemiBold"/>
        </Border>

        <!-- Formulaire -->
        <StackPanel Grid.Row="1" Margin="20,6,20,16">
            <TextBlock Text="NOM *" Style="{StaticResource Etiquette}"/>
            <TextBox Style="{StaticResource Champ}"
                     Text="{Binding Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="SECTEUR *" Style="{StaticResource Etiquette}"/>
            <TextBox Style="{StaticResource Champ}"
                     Text="{Binding Secteur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="SITE WEB" Style="{StaticResource Etiquette}"/>
            <TextBox Style="{StaticResource Champ}"
                     Text="{Binding SiteWeb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="PERSONNE-CONTACT" Style="{StaticResource Etiquette}"/>
            <TextBox Style="{StaticResource Champ}"
                     Text="{Binding ContactNom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="POSTES OFFERTS *" Style="{StaticResource Etiquette}"/>
            <TextBox Style="{StaticResource Champ}" Width="100" HorizontalAlignment="Left"
                     Text="{Binding PostesOfferts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>

        <!-- Boutons -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                        Padding="14,6" MinWidth="90"
                        Background="White" BorderBrush="#CBD5E1"/>
                <Button Content="Enregistrer"
                        Style="{StaticResource BoutonDanger}"
                        Command="{Binding EnregistrerCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>