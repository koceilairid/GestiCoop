<Window x:Class="GestiCoop.UI.Views.EntreprisesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Entreprises"
        Width="1150" Height="650"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Background="#F3F6FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu de gauche -->
        <DockPanel Grid.Column="0" Background="#1F4E79">
            <StackPanel DockPanel.Dock="Top" Margin="18,18,18,8">
                <TextBlock Text="🤝" FontSize="26"/>
                <TextBlock Text="GestiCoop" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,6,0,0"/>
                <TextBlock Text="Collège La Cité" Foreground="#B8C7DC" FontSize="11"/>
                <TextBlock Text="NAVIGATION" Foreground="#B8C7DC" FontSize="10" Margin="0,22,0,0"/>
            </StackPanel>
            <ListBox Background="Transparent" BorderThickness="0"
                     Foreground="White" SelectedIndex="1">
                <ListBoxItem Content="📊  Tableau de bord" Padding="18,9"/>
                <ListBoxItem Content="🏢  Entreprises" Padding="18,9"/>
                <ListBoxItem Content="📋  Offres de stage" Padding="18,9"/>
                <ListBoxItem Content="🎓  Étudiants" Padding="18,9"/>
                <ListBoxItem Content="📝  Candidatures" Padding="18,9"/>
            </ListBox>
        </DockPanel>

        <!-- Contenu -->
        <DockPanel Grid.Column="1">

            <!-- En-tête : titre + recherche + Ajouter -->
            <Border DockPanel.Dock="Top" Background="White"
                    BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="20,12">
                <Grid>
                    <TextBlock Text="Entreprises" FontSize="20" FontWeight="Bold"
                               Foreground="#1F4E79" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBox Width="220" Padding="8,5" Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Rechercher une entreprise..."/>
                        <Button Content="➕ Ajouter"
                                Style="{StaticResource BoutonPrimaire}"
                                Command="{Binding AjouterCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Carte blanche avec la liste -->
            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="8" Margin="16" Padding="0">
                <DockPanel>

                    <!-- Haut de la carte : compteur + Exporter + filtre -->
                    <Grid DockPanel.Dock="Top" Margin="16,12">
                        <TextBlock FontWeight="Bold" Foreground="#1F4E79" FontSize="15"
                                   VerticalAlignment="Center"
                                   Text="{Binding Entreprises.Count, StringFormat={}{0} entreprises partenaires}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="📊 Exporter" Padding="12,5" Margin="0,0,10,0"
                                    Background="White" BorderBrush="#1F4E79" Foreground="#1F4E79"/>
                            <ComboBox Width="160" SelectedIndex="0">
                                <ComboBoxItem Content="Toutes (statuts)"/>
                                <ComboBoxItem Content="Active"/>
                                <ComboBoxItem Content="Archivée"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Tableau des entreprises -->
                    <ListView ItemsSource="{Binding Entreprises}"
                              SelectedItem="{Binding EntrepriseSelectionnee, Mode=TwoWay}"
                              BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="NOM" Width="170">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Nom}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SiteWeb}" Foreground="Gray" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="SECTEUR" Width="190"
                                                DisplayMemberBinding="{Binding Secteur}"/>
                                <GridViewColumn Header="PERSONNE-CONTACT" Width="150"
                                                DisplayMemberBinding="{Binding ContactNom}"/>
                                <GridViewColumn Header="POSTES OFFERTS" Width="110"
                                                DisplayMemberBinding="{Binding PostesOfferts}"/>
                                <GridViewColumn Header="DATE LIMITE" Width="100"
                                                DisplayMemberBinding="{Binding DateLimite, StringFormat=yyyy-MM-dd}"/>

                                <GridViewColumn Header="STATUT" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Padding="8,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#D6F5DD"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Statut}" Value="Archivée">
                                                                <Setter Property="Background" Value="#E5E7EB"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Statut}" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="ACTIONS" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="👁" Width="30" Margin="0,0,4,0"
                                                        Background="White" ToolTip="Voir"/>
                                                <Button Content="✏" Width="30" Margin="0,0,4,0"
                                                        Background="White" ToolTip="Modifier"/>
                                                <Button Content="🗑" Width="30"
                                                        Background="White" ToolTip="Supprimer"
                                                        Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</Window>