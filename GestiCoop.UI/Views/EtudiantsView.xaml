<Window x:Class="GestiCoop.UI.Views.EtudiantsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Gestion des stages coopératifs"
        Width="1050" Height="620"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Menu de gauche -->
            <DockPanel Grid.Column="0" Background="#1F4E79">
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,8">
                    <TextBlock Text="GestiCoop" Foreground="White" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="Stages coopératifs" Foreground="#B8C7DC" FontSize="11"/>
                    <TextBlock Text="PRINCIPAL" Foreground="#B8C7DC" FontSize="10" Margin="0,20,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <TextBlock Text="koceila.IRID" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="Etudiant" Foreground="#B8C7DC" FontSize="11"/>
                </StackPanel>
                <ListBox Background="Transparent" BorderThickness="0"
                         Foreground="White" SelectedIndex="2">
                    <ListBoxItem Content="Tableau de bord" Padding="16,8"/>
                    <ListBoxItem Content="Offres de stage" Padding="16,8"/>
                    <ListBoxItem Content="Étudiants" Padding="16,8"/>
                    <ListBoxItem Content="Candidatures" Padding="16,8"/>
                    <ListBoxItem Content="Entreprises" Padding="16,8"/>
                </ListBox>
            </DockPanel>

            <!-- Contenu -->
            <DockPanel Grid.Column="1" Margin="20" LastChildFill="True">

                <!-- Titre + bouton Ajouter -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Liste des étudiants" FontSize="20" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="+ Ajouter un étudiant" HorizontalAlignment="Right"
                            Style="{StaticResource BoutonDanger}"
                            Command="{Binding AjouterCommand}"/>
                </Grid>

                <!-- Recherche + filtre + compteur -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Padding="6,4"
                             ToolTip="Rechercher un étudiant..."
                             Text="{Binding Recherche, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="1" Width="200" Margin="12,0"
                              ItemsSource="{Binding Programmes}"
                              SelectedItem="{Binding ProgrammeFiltre, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="Gray"
                               Text="{Binding Etudiants.Count, StringFormat={}{0} étudiants}"/>
                </Grid>

                <!-- Liste des étudiants -->
                <ListView ItemsSource="{Binding Etudiants}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="NOM" Width="130"
                                            DisplayMemberBinding="{Binding Nom}"/>
                            <GridViewColumn Header="PRÉNOM" Width="120"
                                            DisplayMemberBinding="{Binding Prenom}"/>
                            <GridViewColumn Header="PROGRAMME" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#DCE6F1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Programme}" Value="Génie logiciel">
                                                            <Setter Property="Background" Value="#D6F5DD"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Programme}" Value="Cybersécurité">
                                                            <Setter Property="Background" Value="#FCEFC7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Programme}" FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="COURRIEL" Width="230"
                                            DisplayMemberBinding="{Binding Courriel}"/>
                            <GridViewColumn Header="ACTIONS" Width="160">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Modifier" Background="Transparent"
                                                    BorderThickness="0" Foreground="#1F4E79" Cursor="Hand"
                                                    Command="{Binding DataContext.ModifierCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                            <TextBlock Text=" · " Foreground="Gray"/>
                                            <Button Content="Supprimer" Background="Transparent"
                                                    BorderThickness="0" Foreground="#E8543F" Cursor="Hand"
                                                    Command="{Binding DataContext.SupprimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Grid>

        <!-- Barre d'état -->
        <StatusBar Grid.Row="1">
            <TextBlock Text="● Connecté : K. Aladji" Foreground="Green"/>
            <Separator/>
            <TextBlock Text="{Binding NombreTotal, StringFormat={}{0} étudiants chargés}"/>
            <Separator/>
            <TextBlock Text="EtudiantsViewModel · ObservableCollection"/>
        </StatusBar>
    </Grid>
</Window>