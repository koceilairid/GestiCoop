<Window x:Class="GestiCoop.UI.Views.TableauDeBord"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Tableau de bord"
        Width="1000" Height="600"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">
    <DockPanel>

        <!-- Menu de gauche -->
        <!-- Menu de gauche -->
        <Border DockPanel.Dock="Left" Width="200" Background="#1F4E79">
            <DockPanel>

                <!-- Haut : logo -->
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="GestiCoop" Foreground="White" FontSize="20"
                               FontWeight="Bold" Margin="16,20,16,0"/>
                    <TextBlock Text="Collège La Cité" Foreground="#B8C7DC"
                               FontSize="11" Margin="16,0,16,20"/>
                </StackPanel>

                <!-- Bas : ton nom -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <TextBlock Text="Koceila Irid" Foreground="White" FontWeight="Bold"/>
                    <TextBlock Text="Étudiant" Foreground="#B8C7DC" FontSize="11"/>
                </StackPanel>

                <!-- Milieu : les boutons du menu -->
                <StackPanel>
                    <Button Content="Tableau de bord" Margin="8,4"
                            Style="{StaticResource BoutonPrimaire}"/>
                    <Button Content="Offres de stage" Margin="8,4"
                            Style="{StaticResource BoutonPrimaire}"
                            Click="Offres_Click"/>
                    <Button Content="Étudiants" Margin="8,4"
                            Style="{StaticResource BoutonPrimaire}"
                            Click="Etudiants_Click"/>
                    <Button Content="Entreprises" Margin="8,4"
        Style="{StaticResource BoutonPrimaire}"
        Click="Entreprises_Click"/>
                    <Button Content="Candidatures" Margin="8,4"
        Style="{StaticResource BoutonPrimaire}"
        Click="Candidatures_Click"/>
                </StackPanel>

            </DockPanel>
        </Border>
        <!-- Contenu -->
        <Grid Background="#F3F6FA">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White"
                    BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                <TextBlock Text="Tableau de bord" FontSize="22" FontWeight="Bold"
                           Foreground="#1F4E79" Margin="20,14"/>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20">
                <Border Width="180" Height="90" Background="White" CornerRadius="6"
                        BorderBrush="#1F4E79" BorderThickness="2" Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="248" FontSize="26" FontWeight="Bold"
                                   Foreground="#1F4E79" HorizontalAlignment="Center"/>
                        <TextBlock Text="Étudiants" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="180" Height="90" Background="White" CornerRadius="6"
                        BorderBrush="#00A651" BorderThickness="2" Margin="0,0,16,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="87" FontSize="26" FontWeight="Bold"
                                   Foreground="#00A651" HorizontalAlignment="Center"/>
                        <TextBlock Text="Offres" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Width="180" Height="90" Background="White" CornerRadius="6"
                        BorderBrush="#E8543F" BorderThickness="2">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="34" FontSize="26" FontWeight="Bold"
                                   Foreground="#E8543F" HorizontalAlignment="Center"/>
                        <TextBlock Text="Entreprises" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="20,0"
                       Text="Bienvenue ! Utilisez le menu à gauche pour ouvrir un écran."
                       FontSize="15" Foreground="#444444"/>
        </Grid>
    </DockPanel>
</Window>