<Window x:Class="GestiCoop.UI.Views.AjouterEtudiantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un étudiant — GestiCoop"
        Width="500" Height="590"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

	<Window.Resources>
		<Style x:Key="Etiquette" TargetType="TextBlock">
			<Setter Property="Foreground" Value="#6B7280"/>
			<Setter Property="FontSize" Value="11"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="0,14,0,4"/>
		</Style>
		<Style x:Key="Champ" TargetType="TextBox">
			<Setter Property="Padding" Value="8,6"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="BorderBrush" Value="#CBD5E1"/>
		</Style>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- En-tête bleu -->
		<Border Grid.Row="0" Background="#1F4E79" Padding="20,14">
			<TextBlock Text="Ajouter un étudiant" Foreground="White"
                       FontSize="17" FontWeight="SemiBold"/>
		</Border>

		<!-- Formulaire -->
		<StackPanel Grid.Row="1" Margin="20,6,20,16">

			<!-- Nom + Prénom côte à côte -->
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="16"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<StackPanel Grid.Column="0">
					<TextBlock Text="NOM *" Style="{StaticResource Etiquette}"/>
					<TextBox Style="{StaticResource Champ}"
                             Text="{Binding Nom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
				<StackPanel Grid.Column="2">
					<TextBlock Text="PRÉNOM *" Style="{StaticResource Etiquette}"/>
					<TextBox Style="{StaticResource Champ}"
                             Text="{Binding Prenom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
				</StackPanel>
			</Grid>

			<!-- Courriel -->
			<TextBlock Text="COURRIEL *" Style="{StaticResource Etiquette}"/>
			<TextBox Text="{Binding Courriel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
				<TextBox.Style>
					<Style TargetType="TextBox" BasedOn="{StaticResource Champ}">
						<Style.Triggers>
							<DataTrigger Binding="{Binding CourrielInvalide}" Value="True">
								<Setter Property="BorderBrush" Value="#E8543F"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBox.Style>
			</TextBox>
			<TextBlock Text="⚠ Adresse courriel invalide — ex. : prenom.nom@etud.lacite.ca"
                       Foreground="#E8543F" FontSize="12" Margin="0,4,0,0">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding CourrielInvalide}" Value="True">
								<Setter Property="Visibility" Value="Visible"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>

			<!-- Programme -->
			<TextBlock Text="PROGRAMME *" Style="{StaticResource Etiquette}"/>
			<ComboBox Padding="8,6" FontSize="14"
                      ItemsSource="{Binding Programmes}"
                      SelectedItem="{Binding Programme, Mode=TwoWay}"/>

			<!-- Numéro d'étudiant (optionnel) -->
			<TextBlock Text="NUMÉRO D'ÉTUDIANT" Style="{StaticResource Etiquette}"/>
			<TextBox Style="{StaticResource Champ}" MaxLength="7" ToolTip="Optionnel"
                     Text="{Binding Numero, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
			<TextBlock Text="Format : 7 chiffres (ex. : 2024001)" FontSize="12" Margin="0,4,0,0">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Foreground" Value="#6B7280"/>
						<Style.Triggers>
							<DataTrigger Binding="{Binding NumeroInvalide}" Value="True">
								<Setter Property="Foreground" Value="#E8543F"/>
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</StackPanel>

		<!-- Boutons -->
		<Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                        Padding="14,6" MinWidth="90"
                        Background="White" BorderBrush="#CBD5E1"/>
				<Button Content="Enregistrer"
                        Style="{StaticResource BoutonDanger}"
                        Command="{Binding EnregistrerCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>