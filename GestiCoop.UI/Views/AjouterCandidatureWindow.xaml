<Window x:Class="GestiCoop.UI.Views.AjouterCandidatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter une candidature — GestiCoop"
        Width="500" Height="430"
        FontFamily="Segoe UI" FontSize="13"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="Etiquette" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête bleu -->
        <Border Grid.Row="0" Background="#1F4E79" Padding="20,14">
            <TextBlock Text="Ajouter une candidature" Foreground="White"
                       FontSize="17" FontWeight="SemiBold"/>
        </Border>

        <!-- Formulaire -->
        <StackPanel Grid.Row="1" Margin="20,6,20,16">

            <TextBlock Text="ÉTUDIANT *" Style="{StaticResource Etiquette}"/>
            <ComboBox Padding="8,6" FontSize="14"
                      ItemsSource="{Binding Etudiants}"
                      SelectedItem="{Binding EtudiantChoisi, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Prenom}" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Nom}"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="OFFRE DE STAGE *" Style="{StaticResource Etiquette}"/>
            <ComboBox Padding="8,6" FontSize="14"
                      ItemsSource="{Binding Offres}"
                      SelectedItem="{Binding OffreChoisie, Mode=TwoWay}"
                      DisplayMemberPath="Titre"/>

            <TextBlock Text="DATE DE CANDIDATURE *" Style="{StaticResource Etiquette}"/>
            <DatePicker SelectedDate="{Binding DateCandidature, Mode=TwoWay}"/>

            <TextBlock Text="STATUT" Style="{StaticResource Etiquette}"/>
            <ComboBox Padding="8,6" FontSize="14"
                      ItemsSource="{Binding Statuts}"
                      SelectedItem="{Binding Statut, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Boutons -->
        <Border Grid.Row="2" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Margin="0,0,8,0"
                        Padding="14,6" MinWidth="90"
                        Background="White" BorderBrush="#CBD5E1"/>
                <Button Content="Enregistrer"
                        Style="{StaticResource BoutonDanger}"
                        Command="{Binding EnregistrerCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>