<Window x:Class="GestiCoop.UI.FormulaireOffre"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formulaire d'offre de stage — GestiCoop"
        Height="480" Width="620"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ligne 0 : Titre -->
        <Label Grid.Row="0" Grid.Column="0" Content="Titre du poste :"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                 MaxLength="100" Margin="4,3"
                 Text="{Binding Titre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Ligne 1 : Secteur + Durée -->
        <Label Grid.Row="1" Grid.Column="0" Content="Secteur :"/>
        <ComboBox Grid.Row="1" Grid.Column="1" Margin="4,3"
                  ItemsSource="{Binding Secteurs}"
                  SelectedItem="{Binding Secteur, Mode=TwoWay}"/>
        <Label Grid.Row="1" Grid.Column="2" Content="Durée (sem.) :"/>
        <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="4,3">
            <Slider Minimum="1" Maximum="52" Width="120" IsSnapToTickEnabled="True"
                    Value="{Binding DureeSemaines, Mode=TwoWay}"/>
            <TextBlock Text="{Binding DureeSemaines}" Margin="6,0,0,0"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Ligne 2 : Date + Rémunération -->
        <Label Grid.Row="2" Grid.Column="0" Content="Date limite :"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="4,3"
                    SelectedDate="{Binding DateLimite, Mode=TwoWay}"/>
        <Label Grid.Row="2" Grid.Column="2" Content="Rémunération ($) :"/>
        <TextBox Grid.Row="2" Grid.Column="3" Margin="4,3" MaxLength="8"
                 Text="{Binding Remuneration, Mode=TwoWay}"/>

        <!-- Ligne 3 : Statut -->
        <Label Grid.Row="3" Grid.Column="0" Content="Statut :"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                    Orientation="Horizontal" Margin="4,3">
            <RadioButton Content="Ouvert" GroupName="Statut" Margin="0,0,12,0"
                         IsChecked="{Binding EstOuvert, Mode=TwoWay}"/>
            <RadioButton Content="Fermé" GroupName="Statut"/>
        </StackPanel>

        <!-- Ligne 4 : Description -->
        <Label Grid.Row="4" Grid.Column="0" Content="Description :"
               VerticalAlignment="Top" Margin="0,6,0,0"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Margin="4,3"
                 TextWrapping="Wrap" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Ligne 5 : Boutons -->
        <StackPanel Grid.Row="5" Grid.ColumnSpan="4"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Enregistrer" IsDefault="True" Margin="0,0,8,0"
                    Style="{StaticResource BoutonPrimaire}"
                    Command="{Binding EnregistrerCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Annuler" IsCancel="True"
                    Style="{StaticResource BoutonDanger}"/>
        </StackPanel>
    </Grid>
</Window>