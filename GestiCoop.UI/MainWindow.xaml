<Window x:Class="GestiCoop.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestiCoop — Gestion des offres de stage"
        Width="950" Height="550"
        FontFamily="Segoe UI" FontSize="13">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="#1F4E79">
            <TextBlock Text="GestiCoop — Gestion des offres de stage"
                       Foreground="White" FontSize="20" Margin="12"/>
        </Border>

        <!-- Contenu : Menu | Liste | Détail -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Menu -->
            <ListBox Grid.Column="0" Background="#DCE6F1"
                     BorderThickness="0" SelectedIndex="0" Padding="0,8">
                <ListBoxItem Content="Offres" Padding="12,8"/>
                <ListBoxItem Content="Entreprises" Padding="12,8"/>
                <ListBoxItem Content="Étudiants" Padding="12,8"/>
                <ListBoxItem Content="Rapports" Padding="12,8"/>
            </ListBox>

            <!-- Liste des offres + boutons -->
            <DockPanel Grid.Column="1" Margin="12">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                            Margin="0,8,0,0">
                    <Button Content="+ Ajouter" Margin="0,0,8,0"
                            Style="{StaticResource BoutonPrimaire}"
                            Command="{Binding AjouterCommand}"/>
                    <Button Content="Supprimer"
                            Style="{StaticResource BoutonDanger}"
                            Command="{Binding SupprimerCommand}"/>
                </StackPanel>

                <ListView ItemsSource="{Binding Offres}"
                          SelectedItem="{Binding OffreSelectionnee, Mode=TwoWay}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Titre" Width="180"
                                            DisplayMemberBinding="{Binding Titre}"/>
                            <GridViewColumn Header="Secteur" Width="120"
                                            DisplayMemberBinding="{Binding Secteur}"/>
                            <GridViewColumn Header="Statut" Width="90"
                                            DisplayMemberBinding="{Binding Statut}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>

            <!-- Détail de l'offre sélectionnée -->
            <Border Grid.Column="2" Background="#F3F6FA"
                    BorderBrush="#DCE6F1" BorderThickness="1,0,0,0">
                <StackPanel Margin="16"
                            DataContext="{Binding OffreSelectionnee}">
                    <TextBlock Text="Détail de l'offre" FontSize="16"
                               FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Titre :" FontWeight="Bold"/>
                    <TextBox Text="{Binding Titre, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,10"/>

                    <TextBlock Text="Secteur :" FontWeight="Bold"/>
                    <TextBox Text="{Binding Secteur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,10"/>

                    <TextBlock Text="Statut :" FontWeight="Bold"/>
                    <TextBox Text="{Binding Statut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,2,0,10"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Barre d'état -->
        <StatusBar Grid.Row="2">
            <TextBlock Text="{Binding Offres.Count, StringFormat={}{0} offre(s)}"/>
        </StatusBar>
    </Grid>
</Window>